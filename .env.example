# Postgres connection string. In production (Netlify) this is populated
# automatically from NETLIFY_DB_URL — see src/lib/db.ts. For local dev, point
# this at any reachable Postgres database (e.g. `netlify dev`, a local
# Postgres, or a free Neon/Supabase database), or leave unset to skip DB setup
# during `npm run build`.
DATABASE_URL=

JWT_SECRET="replace-with-a-long-random-string"
PLATFORM_COMMISSION_PERCENT="8"

# Optional: enables real AI-powered offer ranking via Anthropic's Claude API.
# Without it, a deterministic fallback scorer is used and the app works fully offline.
ANTHROPIC_API_KEY=

# Optional: enables real Stripe Checkout for deal payments.
# Without it, deals can be marked paid via a "simulate payment" demo action.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: enables the background directory importer (Places API "Text
# Search" + "Place Details"), which pulls in real businesses meeting a
# minimum rating/review count from admin-queued ZIP codes. Get a key at
# https://console.cloud.google.com/google/maps-apis/credentials (enable the
# "Places API" for your project; billing must be enabled, priced per request).
# Without it, the queue UI at /dashboard/admin/import stays inert — nothing
# runs and no cost is incurred.
GOOGLE_PLACES_API_KEY=

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: enables real delivery of transactional email (password reset
# links, etc.) via Resend. Get a key at https://resend.com/api-keys and
# verify a sending domain at https://resend.com/domains, then set
# RESEND_FROM_EMAIL to an address on that domain (e.g. no-reply@yourdomain.com).
# Without both set, reset links are only logged server-side — the
# forgot-password flow still works but no email is actually sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
