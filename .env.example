# ─── The assistant ───────────────────────────────────────────────────────────
# Live replies use the Claude Messages API. Without a key the assistant falls
# back to a scripted engine so every screen still works — useful for a demo,
# not for real customers.
ANTHROPIC_API_KEY=sk-ant-...

# ─── This deployment ─────────────────────────────────────────────────────────
# Canonical URLs, sitemap and OG tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain

# Where the SQLite file lives. Point this at a mounted volume in production.
# LOBBY_DATA_DIR=/var/lib/lobby

# Set to false to start with an empty workspace instead of the demo business.
# LOBBY_SEED_DEMO=false

# ─── Required before you publish ─────────────────────────────────────────────
# The privacy policy and terms pages print these. While any of them is unset,
# both pages show a visible "not ready to publish" warning instead of quietly
# inventing a company name.
NEXT_PUBLIC_LEGAL_ENTITY=Your Company Ltd
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain
NEXT_PUBLIC_LEGAL_JURISDICTION=England and Wales

# ─── Password reset and email verification ───────────────────────────────────
# Mail the product sends about itself, kept separate from the per-workspace
# Resend keys entered in the dashboard — a reset happens before anyone knows
# which workspace is involved. Without both, the reset form says so plainly
# instead of pretending a link is on its way, and email verification is off:
# nothing can ask someone to click a link this deployment cannot send. With
# them set, an unconfirmed trial captures messages for a person rather than
# answering them, which is what stops a stranger farming trials on addresses
# that do not exist.
# RESEND_API_KEY=re_...
# AUTH_FROM_EMAIL=auth@your-domain

# ─── Phone calls (optional feature, off per workspace until enabled) ─────────
# The voice bridge is a second process: `npm run voice` alongside `npm start`.
# It reaches the app over this shared secret and refuses to start without one.
# VOICE_BRIDGE_SECRET=another-long-random-string
# Where the bridge listens, and the wss:// URL Twilio should connect to. The
# URL must be reachable from Twilio and must terminate TLS.
# VOICE_BRIDGE_PORT=8080
# VOICE_BRIDGE_URL=wss://voice.your-domain
# Where the bridge finds the app. Localhost is right when both run on one host.
# VOICE_APP_URL=http://127.0.0.1:3000

# ─── Inbound email (optional feature, but fails closed) ──────────────────────
# The inbound webhook REJECTS every request unless this is set — without it,
# anyone could trigger an assistant reply, and a paid model call, on any
# workspace. Set both to turn inbound email on, or neither to leave it off.
# INBOUND_EMAIL_SECRET=a-long-random-string
# INBOUND_EMAIL_DOMAIN=inbound.your-domain

# ─── Taking payment (optional; without it the plans cannot be bought) ────────
# Ours, not the per-workspace Stripe key under Integrations: that one lets a
# customer charge *their* customers. This one charges for Lobby itself.
# Create the three recurring prices in Stripe, then paste their ids here.
# The webhook endpoint REJECTS every request unless the signing secret is set.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
