# Live replies use the Claude Messages API. Without a key the assistant falls
# back to a scripted engine so every screen still works.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: where the SQLite file lives (defaults to ./.data)
# MIDDLEMEN_DATA_DIR=/var/lib/middlemen

# Set to false to start with an empty workspace instead of the demo business
# MIDDLEMEN_SEED_DEMO=false
