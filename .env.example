DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-string"
PLATFORM_COMMISSION_PERCENT="8"

# Optional: enables real AI-powered offer ranking via Anthropic's Claude API.
# Without it, a deterministic fallback scorer is used and the app works fully offline.
ANTHROPIC_API_KEY=

# Optional: enables real Stripe Checkout for deal payments.
# Without it, deals can be marked paid via a "simulate payment" demo action.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL="http://localhost:3000"
