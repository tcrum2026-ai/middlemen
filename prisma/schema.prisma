generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS
  ADMIN
}

enum RequestStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DealStatus {
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
}

enum ListingSource {
  ADMIN_ADDED
  SELF_CLAIMED
  GOOGLE_IMPORTED
}

enum ImportQueueStatus {
  PENDING
  DONE
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  businessProfile     BusinessProfile?
  requests            Request[]
  deals               Deal[]               @relation("CustomerDeals")
  reviews             Review[]
  messages            Message[]
  passwordResetTokens PasswordResetToken[]
}

// A short-lived, single-use token for the forgot-password flow. The raw
// token is emailed to the user and only its sha256 hash is stored, so a
// database read alone can never be used to reset someone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model BusinessProfile {
  id          String   @id @default(cuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyName String
  category    String
  description String
  phone       String?
  website     String?
  hours       String?
  addressLine String?
  city        String?
  state       String?
  zipCode     String
  source      ListingSource @default(ADMIN_ADDED)
  claimed     Boolean       @default(false)
  rating      Float    @default(4.5)
  createdAt   DateTime @default(now())

  // Populated only for listings pulled in by the Google Places importer.
  // sourceRating/sourceReviewCount are Google's own numbers, kept separate
  // from DealBridge's own review system (never blended into displayRating).
  placeId           String?   @unique
  sourceRating      Float?
  sourceReviewCount Int?
  lastSyncedAt      DateTime?

  offers  Offer[]
  deals   Deal[]   @relation("BusinessDeals")
  reviews Review[]

  @@index([zipCode])
  @@index([category])
}

// Drives the background Google Places importer: each row is one
// area+category search to run. The scheduled function works through
// PENDING rows a few at a time so a single run never needs more than a
// handful of API calls (Netlify scheduled functions cap at 30s).
model ImportQueueItem {
  id          String            @id @default(cuid())
  zipCode     String
  category    String
  status      ImportQueueStatus @default(PENDING)
  resultCount Int?
  errorMessage String?
  createdAt   DateTime          @default(now())
  processedAt DateTime?

  @@unique([zipCode, category])
  @@index([status])
}

model Request {
  id          String        @id @default(cuid())
  customerId  String
  customer    User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String
  zipCode     String
  budgetMin   Float
  budgetMax   Float
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())

  offers Offer[]
  deal   Deal?
}

model Offer {
  id            String          @id @default(cuid())
  requestId     String
  request       Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  businessId    String
  business      BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  price         Float
  description   String
  deliveryDays  Int
  status        OfferStatus     @default(PENDING)
  aiScore       Float?
  aiRationale   String?
  createdAt     DateTime        @default(now())

  deal Deal?

  @@unique([requestId, businessId])
}

model Deal {
  id               String     @id @default(cuid())
  requestId        String     @unique
  request          Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offerId          String     @unique
  offer            Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customerId       String
  customer         User       @relation("CustomerDeals", fields: [customerId], references: [id], onDelete: Cascade)
  businessId       String
  business         BusinessProfile @relation("BusinessDeals", fields: [businessId], references: [id], onDelete: Cascade)
  amount           Float
  commissionRate   Float
  commissionAmount Float
  status           DealStatus @default(PENDING_PAYMENT)
  createdAt        DateTime   @default(now())

  review   Review?
  messages Message[]
}

model Review {
  id         String          @id @default(cuid())
  dealId     String?         @unique
  deal       Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  businessId String
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String
  createdAt  DateTime        @default(now())

  @@unique([businessId, customerId])
}

model Message {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}
