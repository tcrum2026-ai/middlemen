generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS
  ADMIN
}

enum RequestStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DealStatus {
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
}

enum ListingSource {
  ADMIN_ADDED
  SELF_CLAIMED
  GOOGLE_IMPORTED
}

enum ImportQueueStatus {
  PENDING
  DONE
  FAILED
}

enum ClaimRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DealFlagStatus {
  OPEN
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  businessProfile     BusinessProfile?
  requests            Request[]
  deals               Deal[]               @relation("CustomerDeals")
  reviews             Review[]
  messages            Message[]
  passwordResetTokens PasswordResetToken[]
  claimRequests       ClaimRequest[]
  dealFlags           DealFlag[]
}

// A generic abuse-prevention counter: one row per attempt, keyed by
// whatever the caller is rate-limiting (e.g. "login:<email>"). Rows older
// than the caller's window are pruned on each check, so this table never
// grows unbounded.
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// A short-lived, single-use token for the forgot-password flow. The raw
// token is emailed to the user and only its sha256 hash is stored, so a
// database read alone can never be used to reset someone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model BusinessProfile {
  id          String   @id @default(cuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyName String
  category    String
  description String
  phone       String?
  website     String?
  hours       String?
  addressLine String?
  city        String?
  state       String?
  zipCode     String
  source      ListingSource @default(ADMIN_ADDED)
  claimed     Boolean       @default(false)
  createdAt   DateTime @default(now())

  // Populated only for listings pulled in by the Google Places importer.
  // sourceRating/sourceReviewCount are Google's own numbers, kept separate
  // from DealBridge's own review system (never blended into displayRating).
  placeId           String?   @unique
  sourceRating      Float?
  sourceReviewCount Int?
  lastSyncedAt      DateTime?

  offers        Offer[]
  deals         Deal[]         @relation("BusinessDeals")
  reviews       Review[]
  claimRequests ClaimRequest[]

  @@index([zipCode])
  @@index([category])
}

// A business owner's request to take ownership of an existing, unclaimed
// directory listing. Always held for an admin to review and approve —
// never auto-approved, since signup never verifies that a user controls
// the inbox at their stated email, so nothing here can be trusted enough
// to skip a human before handing over a listing's reviews and deals.
model ClaimRequest {
  id         String             @id @default(cuid())
  businessId String
  business   BusinessProfile    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     ClaimRequestStatus @default(PENDING)
  // A hint for the admin reviewing this, never a substitute for their
  // approval: the requester's email domain matched the listing's website
  // domain, which is suggestive but proves nothing on its own — nothing in
  // signup verifies that a user actually controls the inbox at their stated
  // email address, so this can never be used to auto-approve a claim.
  domainMatched Boolean         @default(false)
  note       String?
  createdAt  DateTime           @default(now())
  decidedAt  DateTime?

  @@unique([businessId, userId])
  @@index([status])
}

// Drives the background Google Places importer: each row is one
// area+category search to run. The scheduled function works through
// PENDING rows a few at a time so a single run never needs more than a
// handful of API calls (Netlify scheduled functions cap at 30s).
model ImportQueueItem {
  id          String            @id @default(cuid())
  zipCode     String
  category    String
  status      ImportQueueStatus @default(PENDING)
  resultCount Int?
  errorMessage String?
  createdAt   DateTime          @default(now())
  processedAt DateTime?

  @@unique([zipCode, category])
  @@index([status])
}

model Request {
  id          String        @id @default(cuid())
  customerId  String
  customer    User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String
  zipCode     String
  budgetMin   Float
  budgetMax   Float
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())

  offers Offer[]
  deal   Deal?
}

model Offer {
  id            String          @id @default(cuid())
  requestId     String
  request       Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  businessId    String
  business      BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  price         Float
  description   String
  deliveryDays  Int
  status        OfferStatus     @default(PENDING)
  aiScore       Float?
  aiRationale   String?
  createdAt     DateTime        @default(now())

  deal Deal?

  @@unique([requestId, businessId])
}

model Deal {
  id               String     @id @default(cuid())
  requestId        String     @unique
  request          Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offerId          String     @unique
  offer            Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customerId       String
  customer         User       @relation("CustomerDeals", fields: [customerId], references: [id], onDelete: Cascade)
  businessId       String
  business         BusinessProfile @relation("BusinessDeals", fields: [businessId], references: [id], onDelete: Cascade)
  amount           Float
  commissionRate   Float
  commissionAmount Float
  status           DealStatus @default(PENDING_PAYMENT)
  createdAt        DateTime   @default(now())

  review   Review?
  messages Message[]
  flags    DealFlag[]
}

// Either party on a paid deal can flag a problem instead of having no
// recourse but the message thread. Admin sees it in one place and resolves
// it; the reporter gets an email either way, closing a real gap — messaging
// alone gives a customer or business nothing to do if the other side goes
// quiet or the work goes badly.
model DealFlag {
  id             String         @id @default(cuid())
  dealId         String
  deal           Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason         String
  status         DealFlagStatus @default(OPEN)
  resolutionNote String?
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  @@index([status])
  @@index([dealId])
}

model Review {
  id         String          @id @default(cuid())
  dealId     String?         @unique
  deal       Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  businessId String
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String
  createdAt  DateTime        @default(now())

  @@unique([businessId, customerId])
}

model Message {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}
